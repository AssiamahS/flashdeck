{
  "type": "APL",
  "version": "2023.2",
  "mainTemplate": {
    "parameters": ["payload"],
    "items": [
      {
        "type": "Frame",
        "width": "100vw",
        "height": "100vh",
        "backgroundColor": "#0D1117",
        "item": {
          "type": "Container",
          "width": "100vw",
          "height": "100vh",
          "paddingLeft": "5vw",
          "paddingRight": "5vw",
          "paddingTop": "3.5vh",
          "paddingBottom": "2.5vh",
          "direction": "column",
          "items": [
            {
              "type": "Container",
              "direction": "row",
              "width": "100%",
              "alignItems": "center",
              "items": [
                {
                  "type": "Text",
                  "text": "⚡ Flash Deck",
                  "fontSize": "42dp",
                  "fontWeight": "800",
                  "color": "#FFFFFF"
                },
                {
                  "type": "Container",
                  "grow": 1
                },
                {
                  "type": "Text",
                  "text": "${payload.menuData.stats}",
                  "fontSize": "22dp",
                  "color": "#8B98AB"
                }
              ]
            },
            {
              "type": "Text",
              "text": "Tap a deck — or say “study” and its name",
              "fontSize": "22dp",
              "color": "#8B98AB",
              "paddingTop": "4dp",
              "paddingBottom": "18dp"
            },
            {
              "type": "GridSequence",
              "grow": 1,
              "width": "100%",
              "childWidth": ["49%", "49%"],
              "childHeight": "150dp",
              "data": "${payload.menuData.decks}",
              "items": [
                {
                  "type": "TouchWrapper",
                  "onPress": [
                    {
                      "type": "SendEvent",
                      "arguments": ["study", "${data.id}"]
                    }
                  ],
                  "item": {
                    "type": "Frame",
                    "width": "97%",
                    "height": "138dp",
                    "backgroundColor": "#161D29",
                    "borderRadius": "18dp",
                    "item": {
                      "type": "Container",
                      "width": "100%",
                      "height": "100%",
                      "direction": "column",
                      "paddingLeft": "20dp",
                      "paddingRight": "20dp",
                      "paddingTop": "16dp",
                      "paddingBottom": "14dp",
                      "items": [
                        {
                          "type": "Frame",
                          "width": "44dp",
                          "height": "6dp",
                          "borderRadius": "3dp",
                          "backgroundColor": "${data.color}"
                        },
                        {
                          "type": "Text",
                          "text": "${data.name}",
                          "fontSize": "28dp",
                          "fontWeight": "700",
                          "color": "#FFFFFF",
                          "maxLines": 2,
                          "paddingTop": "12dp",
                          "grow": 1
                        },
                        {
                          "type": "Text",
                          "text": "${data.count} cards",
                          "fontSize": "20dp",
                          "color": "${data.color}"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "Text",
              "text": "${payload.menuData.hint}",
              "fontSize": "20dp",
              "color": "#5C6B80",
              "textAlign": "center",
              "paddingTop": "14dp"
            }
          ]
        }
      }
    ]
  }
}
